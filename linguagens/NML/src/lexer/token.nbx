

classe Token: {
    variavel tipos: texto = nulo
    variavel valor: texto = nulo
    variavel final: inteiro_u64 = nulo
    variavel inicio: inteiro_u64 = nulo
    funcao constructor(tipos: texto, valor: texto, final: inteiro_u64, inicio: inteiro_u64): {
        isto.tipos = tipos
        isto.valor = valor
        isto.inicio = inicio
        isto.final = final
    }
    constructor(tipos, valor, final, inicio)
}