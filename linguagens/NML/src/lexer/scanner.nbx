//variaveis para declarar na classe

classe Scanner: {
    variavel posicaoAtual: inteiro_u64 = 0
    variavel fonteNML: texto = nulo
    funcao teste(fonteNML: texto, posicaoAtual: inteiro_u64): {
        isto.fonteNML = fonteNML
        isto.posicaoAtual = posicaoAtual
        
    }
    teste(fonteNML, posicaoAtual)
}